# Supabase
# Find these at: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only service role key. Used by the /admin reports to read all responses
# (bypasses RLS). NEVER prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared password for the /admin reporting area (server-only).
ADMIN_PASSWORD=choose-a-strong-shared-password
